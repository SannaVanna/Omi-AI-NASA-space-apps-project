# Copy this file to .env and fill in values. Never commit your real .env file.

SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true

# Optional: host/port for `python app.py` (defaults 127.0.0.1:5000)
# HOST=127.0.0.1
# PORT=5000

# Optional: Google Gemini key. Without it the assistant still works and
# explains the real analysis results with Omi's built-in explainer.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: only needed if the frontend is hosted on a different domain,
# e.g. CORS_ORIGINS=https://omi-frontend.example.com
CORS_ORIGINS=

# NASA POWER (default source) needs no key.
# Optional: enables the NASA GPM IMERG rainfall source (via NASA Giovanni).
# Create a token at https://urs.earthdata.nasa.gov/ -> Generate Token.
EARTHDATA_TOKEN=
# Alternative to the token (requires `pip install earthaccess`):
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
